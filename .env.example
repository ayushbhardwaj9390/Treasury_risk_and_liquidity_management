# Backend
DATABASE_URL=sqlite:///./treasury.db
GROUP_REPORTING_CURRENCY=USD

# GPT-6 Astra reasoning layer (optional; deterministic treasury engines work without it)
AI_MODEL=gpt-6-astra
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30
AUTH_MODE=demo_header

# MVP-8 live operations
LIVE_EVENT_LAG_WARNING_SECONDS=300
# Required in production for execution-message integrity. Do not commit real secrets.
EXECUTION_SIGNING_SECRET=

# MVP-17 enterprise security / deployment boundaries
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SECRET_PROVIDER=UNCONFIGURED
EXECUTION_SIGNING_KEY_ID=
SIEM_ENDPOINT=
WORKLOAD_IDENTITY_AUDIENCE=

# Production Phase 1 - real data integrations
INTEGRATION_MODE=sandbox
INTEGRATION_TIMEOUT_SECONDS=30
SAP_S4_BASE_URL=
SAP_S4_TOKEN_SECRET_NAME=
ORACLE_FUSION_BASE_URL=
ORACLE_FUSION_TOKEN_SECRET_NAME=
BANK_API_BASE_URL=
BANK_API_TOKEN_SECRET_NAME=
MARKET_DATA_BASE_URL=
MARKET_DATA_TOKEN_SECRET_NAME=
# Production Phases 2-4: set only after a real approved release exists.
# PRODUCTION_RELEASE_ID=1
MAX_REQUEST_BYTES=2097152
